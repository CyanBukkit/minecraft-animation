    "prepack": "npm run skill:check && npm run build",
    "test:web": "node scripts/verify-web.mjs",
    "skill:pack": "node scripts/package-skill.mjs",
    "skill:check": "node scripts/package-skill.mjs --check",
    "test:package": "node scripts/verify-package.mjs"
