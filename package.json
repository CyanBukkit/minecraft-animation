  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "playwright": "^1.64.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "vite": "^8.3.5"
  },
  "bin": {
    "minecraft-animation": "./bin/minecraft-animation.js"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/caibei/index.js",
    "./node": "./src/node/project.js",
